# ==============================================================================
# Konfigurasi Telegram Dev Notifier
# ==============================================================================
# 1. Token Bot Telegram yang diperoleh dari @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# 2. Chat ID / ID Grup Telegram
# Catatan: ID Grup biasanya diawali dengan tanda minus (contoh: -1001234567890 atau -5592860370)
TELEGRAM_CHAT_ID="-1001234567890"

# 3. Webhook Server URL & Secret (Digunakan jika memakai Webhook PHP di server)
AGENTS_TELE_WEBHOOK_URL="https://biru.co.id/tele-vs-code/webhook"
AGENTS_TELE_SECRET="tvsc_your_api_key_here"

# 4. Direktori Target Deploy Otomatis Webhook Server (Lokal / Network Drive)
SERVER_DEPLOY_DIR="U:\domains\biru.co.id\public_html\tele-vs-code"

# 5. Zona Waktu Acuan Notifikasi (contoh: Asia/Jakarta, Asia/Makassar, Asia/Jayapura, UTC)
TIMEZONE="Asia/Jakarta"


