<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /tele-vs-code/

# Webhook Endpoint Route
RewriteRule ^webhook/?$ index.php?is_webhook=1 [QSA,L]
</IfModule>

# Default Server Timezone GMT+7 (Asia/Jakarta)
<IfModule mod_php.c>
    php_value date.timezone Asia/Jakarta
</IfModule>
<IfModule mod_php7.c>
    php_value date.timezone Asia/Jakarta
</IfModule>
<IfModule mod_php8.c>
    php_value date.timezone Asia/Jakarta
</IfModule>


